# ---------------------------------------------------------------------------
# PostgreSQL (docker-compose reads the POSTGRES_* values; the app reads DATABASE_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
POSTGRES_PORT=5432

DATABASE_URL=postgresql://rag:change-me@localhost:5432/rag
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# API keys (never commit real values)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings: "openai" or "ollama" (independent of LLM_PROVIDER)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the database column; change it with
#   python -m scripts.migrate --set-embedding-dimensions N
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
# Optional task prefixes (nomic-embed-text needs these, OpenAI doesn't)
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=

# ---------------------------------------------------------------------------
# Answer generation: "claude", "openai" or "ollama"
# ---------------------------------------------------------------------------
LLM_PROVIDER=claude
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-opus-5-5
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
# Optional; only sent to OpenAI. Leave empty for the model default.
OPENAI_TEMPERATURE=
# Claude effort level: low | medium | high | xhigh | max (empty = model default)
ANTHROPIC_EFFORT=medium
# Re-run a safety-classifier decline on Anthropic's recommended fallback model
ANTHROPIC_REFUSAL_FALLBACK=true
# Answer text: plain (no Markdown, show to users as is) | markdown
#   | spoken (natural speech for text-to-speech: no citations, headings, lists or symbols)
ANSWER_FORMAT=plain
# Citations for plain/markdown: numbered ([1] -> sources[].id) | document ([file.pdf, p. 12])
CITATION_STYLE=numbered

# ---------------------------------------------------------------------------
# Ollama (local models; no API key). Fully local setup:
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768
#   EMBEDDING_DOCUMENT_PREFIX="search_document: "
#   EMBEDDING_QUERY_PREFIX="search_query: "
#   LLM_PROVIDER=ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Context window sent with every chat request (Ollama's default is small)
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=
OLLAMA_KEEP_ALIVE=

# ---------------------------------------------------------------------------
# Chunking (token counts use the cl100k_base tokenizer)
# ---------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
TOP_K=5
# Minimum cosine similarity (0-1) for a chunk to be used as context
SIMILARITY_THRESHOLD=0.3
# Token budget for retrieved context sent to the LLM
MAX_CONTEXT_TOKENS=6000
HNSW_EF_SEARCH=100

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
PDF_DIRECTORY=dataloads
MAX_PDF_SIZE_MB=200

# ---------------------------------------------------------------------------
# Retries for embedding and LLM calls (exponential backoff with jitter)
# ---------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0

# ---------------------------------------------------------------------------
# Logging: json | text
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
